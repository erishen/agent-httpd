# Docker 构建上下文排除项 (镜像内在多阶段构建里重新生成这些产物)
.git
build/
bin/
logs/
*.o
*.d
docker-compose.override.yml

# SSR 依赖在构建阶段内 npm ci 重新安装, 不拷贝宿主机的 node_modules
cgi-bin/react-ssr/node_modules
cgi-bin/react-ssr/tailwind.css

# 客户端 bundle 及其预压缩表亲由 ssr-build 阶段生成 (Dockerfile 里显式 COPY)。
# 构建上下文里的那两份是宿主工作树的旧产物, 而浏览器只读 gzip 那份 —— 一旦它
# 陈旧, 所有人都在跑上一次的代码, 构建却一切"成功"。禁止它们混进来。
www/js/react-ssr.js
www/js/react-ssr.js.gz

# 平台相关的宿主机预编译 CGI (macOS Mach-O): 容器内由 cgi-build 阶段
# 用 Linux 工具链重新编译, 这里的旧产物不进构建上下文。
# cgi-langs/ 源码必须保留 —— Dockerfile 的 cgi-build 阶段要用它们编译。
cgi-bin/go.cgi
cgi-bin/rust.cgi
cgi-bin/java.cgi

# 文档与本地实验产物不进镜像
docs/
*.log

# smoke 套件的临时夹具。脚本跑完自己会删, 但运行被中断时会留在工作树里;
# 尤其 www/fixlist 是「大目录列表」用例造的两千项目录, 一旦进上下文就会
# 被 `COPY www/ www/` 原样搬进镜像 —— 与上面的 .gz 表亲是同一类事故:
# 构建一切"成功", 镜像里却混着宿主工作树的测试残渣。
cgi-bin/.*-test.cgi
www/fixlist/
www/range-test-smoke.bin
www/js/fix-mid.bin

# 密钥文件绝不进镜像 (compose 在运行时经 env_file 注入容器)
.env

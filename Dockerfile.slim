# agent-httpd 精简版容器 —— 三阶段构建 (slim+: CGI 动物园完整)
#
# 与 Dockerfile (全功能版, ~0.77GB) 的取舍:
#   砍掉: npx MCP 预热 (87MB) / chown 重复层 (COPY --chown 一步到位)
#   保留: C 服务器本体 + 全部静态 UI + chat SSE 中继 (fork curl) +
#         bash/python/go/rust/java/php/ruby CGI 动物园 + React SSR CGI +
#         python3 echo MCP 演示 + healthcheck/LLM 上游共用的 python3+curl
#   运行时基座: node:24-bookworm-slim (即 debian bookworm-slim + node24),
#         node 供 react-ssr.cgi 自包含 bundle 使用 (无需 node_modules)
#   失去: router 同步出的 npx 版 MCP server 预热缓存 (运行时可现装,
#         echo 演示不受影响) —— 只影响首次 MCP init 速度
#
# 用法:
#   docker build -f Dockerfile.slim -t agent-httpd:slim .
#   docker run -p 8080:8080 --env-file .env.cloud agent-httpd:slim

# ---------- 阶段 1: C 服务器 (与全功能版同源同 CFLAGS) ----------
FROM debian:bookworm-slim AS c-build
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev libcrypt-dev make \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Makefile ./
COPY src/ src/
RUN make all

# ---------- 阶段 2: 原生 CGI (go/rust 编译 + java/php wrapper 生成) ----------
# java.cgi/php.cgi 由 build-cgis.sh 在本阶段生成 (.dockerignore 刻意排除
# 宿主产物), 因此需要 javac + php-cgi; ruby.cgi 是源码脚本, 由阶段 3 全量带入
FROM debian:bookworm-slim AS cgi-build
RUN apt-get update \
    && apt-get install -y --no-install-recommends golang-go rustc \
       default-jdk-headless php-cgi \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY cgi-langs/ cgi-langs/
COPY scripts/build-cgis.sh scripts/
RUN sh scripts/build-cgis.sh

# ---------- 阶段 3: 运行时 (node:24-bookworm-slim + CGI 解释器, 约 600MB) ----------
FROM node:24-bookworm-slim
# node:24-bookworm-slim = debian bookworm-slim + node/npm: react-ssr.cgi 是
# esbuild 自包含 bundle, 只要 node 就能跑, 不需要 node_modules。
# 选 bookworm 变体 (而非默认 trixie) 与阶段 1/2 的 debian:bookworm-slim
# 保持同系 glibc, 避免跨阶段二进制混用不同 glibc。
# python3: CGI 动物园 + fake MCP 演示 + 容器 healthcheck;
# curl: src/agent/llm.c 的 LLM 上游通道 (fork curl -N 流式);
# ca-certificates: curl 走 https 上游必需 (漏掉 chat 会 "upstream connection failed");
# ruby/php-cgi/default-jre-headless: ruby.cgi / php.cgi / java.cgi 的解释器。
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 curl ca-certificates \
       ruby php-cgi default-jre-headless \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 10001 --create-home --home-dir /home/agent agent
WORKDIR /app
# 容器专用基础 MCP 配置 (echo 演示, python3 自包含零下载); 无 node,
# router 同步的 npx 配方在运行时 init 会失败 —— 精简版已知取舍
COPY deploy/mcp-servers.container.json .data/mcp-servers.json
COPY scripts/fake-mcp-server.py scripts/
COPY skills/ skills/
# 工作目录即 docroot (agent-httpd 以 cwd 为根, 需要 /app/www);
# COPY --chown 一步到位, 避免 chown -R 产生整树重复层
COPY --chown=agent:agent www/ www/
COPY --chown=agent:agent --from=c-build /src/bin/agent-httpd bin/
# 脚本类 CGI 全量带入 (bash/python/ruby/php 成员可用); 原生类带 go/rust
# 自包含二进制 + java.cgi/php.cgi (阶段 2 生成) + classes (阶段 2 重编译) +
# react-ssr 自包含 bundle (node 在基座里)
COPY --chown=agent:agent cgi-langs/php/ cgi-langs/php/
COPY --chown=agent:agent --from=cgi-build /build/cgi-langs/java/classes/ cgi-langs/java/classes/
COPY --chown=agent:agent cgi-bin/ cgi-bin/
COPY --chown=agent:agent --from=cgi-build /build/cgi-bin/go.cgi /build/cgi-bin/rust.cgi \
     /build/cgi-bin/java.cgi /build/cgi-bin/php.cgi cgi-bin/
RUN chmod +x bin/agent-httpd cgi-bin/*.cgi \
    && mkdir -p /var/log/agent-httpd /run/agent-httpd \
    && chown agent:agent /var/log/agent-httpd /run/agent-httpd
COPY --chown=agent:agent deploy/docker-entrypoint.sh /usr/local/bin/docker-entrypoint
RUN chmod +x /usr/local/bin/docker-entrypoint

ENV PORT=8080 WORKERS=8 RATE_LIMIT=0
EXPOSE 8080
USER agent
ENTRYPOINT ["docker-entrypoint"]

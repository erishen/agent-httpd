# agent-httpd 云机部署环境配置（模板，无密钥可提交）
# ============================================================
# 用途：给云机上的单容器实例注入环境变量（镜像默认只带 PORT/WORKERS/RATE_LIMIT，
#       LLM_* 缺省时 chat 回落演示引擎，页面其余功能不受影响）。
#
# ⚠️ 公网必读：下面两项都不是默认安全的，别把它们改回去
#   1. 限流与鉴权是两件事，**两样都要**：
#      · 每 IP 限流 = RATE_LIMIT（本文件已设为 20，不要填 0 —— 0 表示「关闭」）
#      · Basic Auth = AUTH_HTPASSWD（本文件已设；由 deploy/docker-entrypoint.sh
#        翻译成命令行的 -a <htpasswd>）
#      只开限流挡不住慢速爬取/滥用，只开鉴权挡不住拿到口令后的高频调用。
#      AUTH_HTPASSWD 指向的文件不存在/不可读时 entrypoint **直接退出**，不会静默
#      降级成开放访问。
#
#      云机上一次性生成（bcrypt 强哈希；服务端只接受 $5$/$6$/bcrypt）：
#        htpasswd -B -c /srv/agent-httpd.htpasswd <用户名>
#      没有 htpasswd 命令时：
#        printf '%s:%s\n' <用户名> "$(openssl passwd -6 '<密码>')" > /srv/agent-httpd.htpasswd
#
#   2. 前面若有反向代理（nginx 等），必须设 RATE_LIMIT_TRUSTED_PROXIES，
#      否则所有请求都记在代理那一个 IP 头上 —— 限流退化成「全局限流」，
#      既拦不住单点滥用，又会误伤正常用户。
#
# 启用步骤（将来接通 chat 时）：
#   1. 复制本文件为 deploy/.env.cloud（已被 .gitignore，填密钥不会进 git）
#   2. scp deploy/.env.cloud <云机>:/srv/agent-httpd.env
#      并把 htpasswd 一起送过去：scp /srv/agent-httpd.htpasswd <云机>:/srv/
#   3. cicdkit 项目配置 ssh_run_args 改为（挂载 htpasswd，否则容器内看不到它）:
#        -p 8080:8080 --env-file /srv/agent-httpd.env --restart unless-stopped
#        -v /srv/agent-httpd.htpasswd:/srv/agent-httpd.htpasswd:ro
#   4. 重跑流水线（构建全缓存，秒级），或云机上手动 docker rm -f + 上述参数 run
#   5. 验证（三项都要看到预期结果）:
#        curl -i http://<云机IP>:8080/api/status                # 期望 401
#        curl -i -u <用户名>:<密码> http://<云机IP>:8080/api/status
#        for i in $(seq 1 40); do curl -s -o /dev/null -w '%{http_code} ' \
#          -u <用户名>:<密码> http://<云机IP>:8080/api/status; done
#        # 末尾应出现 429（限流生效，且带 Retry-After）
#      （云机安全组记得放行/限源 8080）
#
# --- 服务 ---
PORT=8080
WORKERS=8

# 每 IP 限流 (req/s)，由 deploy/docker-entrypoint.sh 翻译成 `-l <rps>`。
# 0 = 关闭（服务端默认值），公开实例**不要**用 0。
# 直接跑二进制（不经 entrypoint）时等价的变量名是 RATE_LIMIT_RPS。
RATE_LIMIT=20

# Basic Auth。路径必须是**容器内**可见的（见上面步骤 3 的挂载）。
# 留空 = 完全不鉴权 —— 只应在纯内网/本机调试时这么做。
AUTH_HTPASSWD=/srv/agent-httpd.htpasswd

# 可选：认证 realm（浏览器弹窗里显示的名字），默认 agent-httpd
# AUTH_REALM=agent-httpd

# 反向代理场景才需要：逗号分隔的可信代理地址/网段（仅 IPv4）。
# 仅当直接对端落在该列表内，才会采信 X-Forwarded-For 首跳作为限流 key。
# RATE_LIMIT_TRUSTED_PROXIES=172.17.0.1

# --- LLM 上游（chat 功能）---
# ⚠️ LLM_API_URL 必须是完整端点（代码不做路径拼接），以 /chat/completions 结尾。
# 三选一填入（本模板保持留空 = 维持演示引擎）：
#   A. 云机同机跑 tsm-hub:      http://127.0.0.1:9070/v1/chat/completions
#      （tsm-hub 也是 Go 单二进制，可用 cicdkit 走同一条 ssh 直传流水线部署）
#   B. 公网 API 直连:           https://apihub.agnes-ai.com/v1/chat/completions
#      （最快，但绕过 tsm-hub 的记账/路由，key 散落在云机上）
#   C. 家庭网关公网化（frp 等）: https://<你的域名>/v1/chat/completions
#      （sk-tr key 体系保留，但家庭宽带暴露面 +1，需谨慎）
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=auto

# --- Agent 数据边界 ---
# MCP / exec 工具进程的文件系统根。云机是公网机器，务必只指向容器内
# 无敏感内容的目录（不要挂宿主密钥/家目录进来）。注意：根目录若包含
# .data 会话存储，fs MCP 工具就能读到全部聊天记录（服务启动会告警）——
# 用 docroot 即可：目录存在、内容仅演示页，且不含 .data。
MCP_FS_ROOT=/app/www

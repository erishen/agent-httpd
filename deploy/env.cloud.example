# agent-httpd 云机部署环境配置（模板，无密钥可提交）
# ============================================================
# 用途：给云机上的单容器实例注入环境变量（镜像默认只带 PORT/WORKERS/RATE_LIMIT，
#       LLM_* 缺省时 chat 回落演示引擎，页面其余功能不受影响）。
#
# 启用步骤（将来接通 chat 时）：
#   1. 复制本文件为 deploy/.env.cloud（已被 .gitignore，填密钥不会进 git）
#   2. scp deploy/.env.cloud <云机>:/srv/agent-httpd.env
#   3. cicdkit 项目配置 ssh_run_args 改为:
#        -p 8080:8080 --env-file /srv/agent-httpd.env --restart unless-stopped
#   4. 重跑流水线（构建全缓存，秒级），或云机上手动 docker rm -f + 上述参数 run
#   5. 验证: curl http://<云机IP>:8080/api/status 看引擎字段
#      （云机安全组记得放行/限源 8080）
#
# --- 服务 ---
PORT=8080
WORKERS=8
RATE_LIMIT=0

# --- LLM 上游（chat 功能）---
# 三选一填入（本模板保持留空 = 维持演示引擎）：
#   A. 云机同机跑 tsm-hub:      http://127.0.0.1:9070/v1
#      （tsm-hub 也是 Go 单二进制，可用 cicdkit 走同一条 ssh 直传流水线部署）
#   B. 公网 API 直连:           https://apihub.agnes-ai.com/v1
#      （最快，但绕过 tsm-hub 的记账/路由，key 散落在云机上）
#   C. 家庭网关公网化（frp 等）: https://<你的域名>/v1
#      （sk-tr key 体系保留，但家庭宽带暴露面 +1，需谨慎）
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=auto

# --- Agent 数据边界 ---
# MCP / exec 工具进程的文件系统根。云机是公网机器，务必只指向容器内
# 无敏感内容的目录（不要挂宿主密钥/家目录进来）。
MCP_FS_ROOT=/app

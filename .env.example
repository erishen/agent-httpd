# agent-httpd LLM 聊天后端配置 (模板)
# 复制为 .env 后按需填写:  cp .env.example .env
#
# 读取方:
#   - C 服务器 src/agent/llm.c: 启动后首个聊天请求时从工作目录读 .env 里的 LLM_*
#     (环境变量已存在的优先 —— 测试可用空 LLM_API_KEY 强制回落演示引擎);
#   - docker compose: httpd 与 react 服务都经 env_file 注入 (文件不存在
#     也能启动, 回落演示引擎)。注意 compose 会把这两个服务的 LLM_API_URL
#     覆盖成容器可达的宿主网关地址 —— 见下方"容器内地址";
#   - make dev:       node --env-file-if-exists=.env 自动加载 (HMR 链路的
#     chat.ts 仍读 process.env.LLM_*)

# OpenAI 兼容的 chat/completions 端点 —— 完整端点或基础 URL 均可 (代码自动补 /chat/completions)
#   OpenAI:   https://api.openai.com/v1/chat/completions
#   DeepSeek: https://api.deepseek.com/chat/completions
#   Ollama:   http://host.docker.internal:11434/v1/chat/completions (本地)
#
# 容器内地址: 本行填的 localhost 只在宿主成立 —— 容器里的 localhost 是容器自己的
#   loopback, 连不到宿主上的服务。所以 docker-compose.yml 给 httpd / react 两个
#   服务单独覆盖了 LLM_API_URL (文件顶部的 x-llm-api-url, 默认
#   http://host.docker.internal:9070/v1), 这里因此可以继续写 http://localhost:...
#   而宿主 `make dev` / 直接跑 ./bin/agent-httpd 仍按本行原样读。
#   上游不在宿主本机 (或在别的端口) 时, 换掉容器那侧即可 —— 本文件或 shell 里设
#   LLM_API_URL_CONTAINER=http://10.0.0.5:9070/v1 再 docker compose up -d。
LLM_API_URL=https://api.openai.com/v1/chat/completions

# API 密钥 —— 留空 = 内置演示引擎 (逐 token 回显你的消息, 无外部依赖)
LLM_API_KEY=

# 模型名 (随服务商: gpt-4o-mini / deepseek-chat / llama3 ...)
LLM_MODEL=gpt-4o-mini

# C 端点上游超时秒数 (src/llm.c, 默认 60; 超时回 error 事件)
#LLM_TIMEOUT=60

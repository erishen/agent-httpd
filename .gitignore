# build artifacts
build/
bin/
logs/
*.o
*.d

# package manager for cgi-bin/react-ssr is pnpm (see packageManager in its
# package.json); pnpm-lock.yaml IS tracked so the committed SSR bundles and
# tailwind.css stay reproducible. npm's lockfile is not a second source of
# truth -- and it used to be ignored only by a machine-local
# ~/.gitignore_global entry, so on any other checkout it was untracked-and-
# stageable. Ignore it repo-wide on purpose.
cgi-bin/react-ssr/package-lock.json

# toolchain scratch: some builders stage an output as .!<pid>!<name> next to
# the target before renaming it, which left a stray 0-byte cgi-bin entry
cgi-bin/.!*

# secrets (templates: .env.example / deploy/env.cloud.example)
# Repo-level on purpose: `deploy/.env.local` used to be covered only by a
# machine-local ~/.gitignore_global entry, so on any other checkout (or CI)
# the key file showed up as untracked-and-stageable. Ignore every .env
# variant here, then re-allow the templates.
.env
.env.*
!.env.example
!*.env.example
deploy/.env.local

# runtime state: sessions / MCP registrations / memory (contains conversation data + absolute paths)
.data/

# runtime/dev logs
.dev-httpd.log
.dev-server.out
*.log

# macOS noise
.DS_Store
._*

# unit-test binaries (built by `make test-unit`)
tests/t_vite
tests/t_fcgi
tests/t_ka
tests/t_auth
tests/t_json

# embedded example binary (built by `make example`)
examples/embedded

# smoke-test scratch. The suite writes these into the docroot and removes them
# again; a run cut short (or one whose deletes hit the sandbox's bulk-delete
# guard, e.g. after www/fixlist's 2000 entries) leaves them behind.
cgi-bin/.*-test.cgi
cgi-bin/probe-*.cgi
www/fixlist/
www/range-test-smoke.bin
www/js/fix-mid.bin

# cloud deploy env (real one, may hold keys)
deploy/.env.cloud
# 含密钥的备份(如 gemini 端点尝试)
deploy/.env.cloud.*

# cicdkit needs a server-visible ABSOLUTE build context, so the real project
# file is inherently machine-specific (and leaks the local username/layout if
# committed). The tracked deploy/cicdkit-project.example.json is the template.
deploy/cicdkit-project.json

# demo: teaching playground. Only the hand-written *.c sources and the
# Makefile are tracked; the generated *.s assembly dumps and the compiled
# Mach-O binaries are build artifacts (regenerate locally via
# asm-demo/Makefile) and stay ignored.
asm-demo/*
!asm-demo/*.c
!asm-demo/Makefile
